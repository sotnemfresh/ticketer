// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  OPEN
  NEW
  PENDING
  ON_HOLD
  CLOSED
  SOLVED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id          Int            @id @default(autoincrement())
  subject     String
  description String?
  status      TicketStatus   @default(NEW)
  priority    TicketPriority @default(MEDIUM)
  source      TicketSource   @default(WEB)

  requesterId Int
  assigneeId  Int?

  conversationId String?
  closedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  TicketMessage[]
  followers TicketFollower[]

  requester User  @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee  User? @relation("TicketAssignee", fields: [assigneeId], references: [id])

  followUpOfId Int?
  followUpOf   Ticket? @relation("TicketFollowUp", fields: [followUpOfId], references: [id])
  followUps    Ticket[] @relation("TicketFollowUp")

  @@index([conversationId])
  @@index([status, closedAt])
  @@index([followUpOfId])
}

model TicketMessage {
  id       Int         @id @default(autoincrement())
  ticketId Int
  authorId Int?
  type     MessageType @default(INTERNAL_NOTE)

  authorEmail String?
  authorName  String?

  bodyText String
  bodyHtml String?

  messageIdHeader String?  @unique
  inReplyTo       String?
  references      String[]
  graphMessageId  String?  @unique

  createdAt DateTime @default(now())

  ticket      Ticket       @relation(fields: [ticketId], references: [id])
  author      User?        @relation(fields: [authorId], references: [id])
  attachments Attachment[]

  outboundDelivery OutboundDelivery?

  @@index([ticketId, createdAt])
  @@index([inReplyTo])
}

enum OutboundDeliveryStatus {
  PENDING
  PREPARING
  READY
  SENDING
  ACCEPTED
  UNKNOWN
  FAILED
}

model OutboundDelivery {
  id        Int @id @default(autoincrement())
  messageId Int @unique

  status OutboundDeliveryStatus @default(PENDING)

  senderMailbox String
  toEmails      String[]
  ccEmails      String[] @default([])
  subject       String
  bodyHtml      String

  replyToGraphMessageId String?
  inReplyTo             String?
  references            String[] @default([])

  graphDraftId      String?
  internetMessageId String?

  attemptCount  Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastAttemptAt DateTime?
  lastError     String?

  nextReconcileAt    DateTime?
  reconcileCount     Int       @default(0)
  needsInvestigation Boolean   @default(false)
  metadataVerifiedAt DateTime?

  leaseToken     String?
  leaseExpiresAt DateTime?

  sendStartedAt DateTime?
  acceptedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  message TicketMessage @relation(fields: [messageId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([status, nextReconcileAt])
  
}

model Attachment {
  id                Int       @id @default(autoincrement())
  messageId         Int
  filename          String
  mimeType          String
  size              Int
  contentId         String?
  isInline          Boolean   @default(false)
  storageKey        String?   @unique
  graphAttachmentId String?
  contentHash       String?
  purgedAt          DateTime?
  createdAt         DateTime  @default(now())

  message TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([contentHash])
}

enum UserRole {
  ADMIN
  AGENT
  VIEWER
  CUSTOMER
}

enum MessageType {
  INBOUND // email received from a customer
  OUTBOUND // public reply, emailed to requester and followers
  INTERNAL_NOTE // never emailed
}

enum TicketSource {
  WEB
  EMAIL
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String?
  role         UserRole @default(AGENT)
  jobTitle     String?

  requestedTickets Ticket[] @relation("TicketRequester")
  assignedTickets  Ticket[] @relation("TicketAssignee")

  messages  TicketMessage[]
  following TicketFollower[]
}

enum FollowerType {
  CC
  FOLLOWER
}

model TicketFollower {
  id       Int          @id @default(autoincrement())
  ticketId Int
  userId   Int?
  email    String
  type     FollowerType @default(CC)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@unique([ticketId, email])
}

model MailboxSettings {
  id             Int       @id @default(1)
  mailboxAddress String?
  enabled        Boolean   @default(false)
  deltaLink      String?
  lastSyncAt     DateTime?
  lastError      String?
  updatedAt      DateTime  @updatedAt
}
